{
  "name": "vetrx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VetRx — Veterinary Practitioner Platform (Web Frontend + REST Backend)",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "concurrently \"npm run dev --workspace=web\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspace=web && npm run lint --workspace=server",
    "lint:web": "npm run lint --workspace=web",
    "lint:server": "npm run lint --workspace=server",
    "test": "npm run test --workspace=server",
    "test:web": "npm run test --workspace=web",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "tsx ./prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
