// ==============================================================================
// VetRx Multi-Tenant Schema (Prisma)
// Stage 0 + Stage 1: Authentication, Sessions, Practice Ownership & Isolation
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum Role {
  PRACTICE_OWNER
  PRACTICE_ADMIN
  VETERINARIAN
  STAFF
  PRACTICE_STAFF // legacy alias for STAFF
  READ_ONLY
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum IdentityProviderType {
  GOOGLE
  PASSWORD
  FUTURE_MYKGVOA
}

enum OverrideEffect {
  ALLOW
  DENY
}

enum PracticeType {
  INDEPENDENT
  CLINIC
  ENTERPRISE
}

enum PracticeStatus {
  ACTIVE
  SUSPENDED
}

enum IssueCategory {
  LOGIN_AUTH
  INVITATION
  PRACTICE_SETUP
  USER_PERMISSIONS
  PRESCRIPTION
  PATIENT
  INVOICE_BILLING
  SUBSCRIPTION
  PAYMENT
  PDF_PRINT
  TECHNICAL
  OTHER
}

enum IssuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

// ------------------------------------------------------------------------------
// User & Authentication Models
// ------------------------------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  normalizedEmail String           @unique
  name            String
  avatarUrl       String?
  emailVerified   Boolean          @default(false)
  passwordHash    String?          // Nullable for OAuth-only users
  isActive        Boolean          @default(true)
  platformRole    PlatformRole?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastLoginAt     DateTime?

  // Relations
  authIdentities  AuthIdentity[]
  memberships     PracticeMember[]
  ownedPractices  Practice[]       @relation("PracticeOwner")
  sessions        Session[]
  auditLogs       AuditLog[]
  invitationsSent PracticeInvitation[] @relation("UserInvitationsSent")

  // Overrides and Prescription Clinical Workflow Relations
  permissionOverridesCreated        MemberPermissionOverride[]   @relation("PermissionOverrideCreatedBy")
  prescriptionsForwarded             Prescription[]               @relation("PrescriptionForwardedBy")
  prescriptionsAssigned              Prescription[]               @relation("PrescriptionForwardedTo")
  prescriptionsApproved              Prescription[]               @relation("PrescriptionApprovedBy")
  prescriptionsRequestedChanges      Prescription[]               @relation("PrescriptionRequestedBy")
  prescriptionWorkflowActions        PrescriptionWorkflowHistory[]
  prescriptionWorkflowTargetActions  PrescriptionWorkflowHistory[] @relation("WorkflowHistoryTargetUser")

  // Support and Platform Relations
  assignedIssues                     PlatformIssue[]              @relation("AssignedIssues")
  reportedIssues                     PlatformIssue[]              @relation("ReportedIssues")
  supportSessionsAdmin               SupportAccessSession[]       @relation("SupportAdminSessions")
  supportSessionsTarget              SupportAccessSession[]       @relation("TargetSupportSessions")

  @@index([normalizedEmail])
}

model AuthIdentity {
  id             String               @id @default(uuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String               // 'google', 'password', 'future_mykgvoa'
  providerUserId String               // Stable subject ID from provider
  providerEmail  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId       String?
  practice         Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  sessionTokenHash String    @unique // SHA-256 hash of raw session token
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  revokedAt        DateTime?

  @@index([userId])
  @@index([practiceId])
  @@index([sessionTokenHash])
  @@index([expiresAt])
}

// ------------------------------------------------------------------------------
// Tenant Boundary: Practice & Practice Membership
// ------------------------------------------------------------------------------

model Practice {
  id           String         @id @default(uuid())
  name         String
  slug         String?        @unique
  ownerUserId  String
  owner        User           @relation("PracticeOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  practiceType PracticeType   @default(CLINIC)
  status       PracticeStatus @default(ACTIVE)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  members     PracticeMember[]
  settings    PracticeSettings?
  invitations PracticeInvitation[]
  sessions    Session[]

  // Clinical Data Tenant Scoping (Future Stages)
  owners            Owner[]
  patients          Patient[]
  medicines         Medicine[]
  treatmentPackages TreatmentPackage[]
  prescriptions     Prescription[]
  invoices          Invoice[]
  receipts          Receipt[]
  documentSequences DocumentSequence[]
  auditLogs         AuditLog[]

  // Call & Visit Planner (CVP) Tenant Scoping
  calls                       Call[]
  ownerLocations              OwnerLocation[]
  visits                      Visit[]
  dailyPlans                  DailyPlan[]
  followUps                   FollowUp[]
  recurringSchedules          RecurringSchedule[]
  procedureDurationEstimates  ProcedureDurationEstimate[]

  // Commercial Relations (Phase 10 Foundation)
  subscriptions     Subscription[]
  payments          Payment[]

  // Platform Relations
  issues          PlatformIssue[]
  supportSessions SupportAccessSession[]

  // Inventory Add-On Relations
  inventoryItems        InventoryItem[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  suppliers             Supplier[]
  purchaseInvoices      PurchaseInvoice[]
  stockLocations        StockLocation[]

  @@index([ownerUserId])
}

model PracticeMember {
  id         String    @id @default(uuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @default(PRACTICE_OWNER)
  isActive           Boolean   @default(true)
  isClinicalApprover Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  permissionOverrides MemberPermissionOverride[]

  @@unique([practiceId, userId])
  @@index([practiceId])
  @@index([userId])
}

model MemberPermissionOverride {
  id               String         @id @default(uuid())
  practiceMemberId String
  practiceMember   PracticeMember @relation(fields: [practiceMemberId], references: [id], onDelete: Cascade)
  permission       String
  effect           OverrideEffect @default(ALLOW)
  createdByUserId  String
  createdBy        User           @relation("PermissionOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([practiceMemberId, permission])
  @@index([practiceMemberId])
}

model PracticeInvitation {
  id          String           @id @default(uuid())
  practiceId  String
  practice    Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  email       String
  role        Role             @default(STAFF)
  tokenHash   String           @unique
  invitedById String
  invitedBy   User             @relation("UserInvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([practiceId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
}

model PracticeSettings {
  id                             String   @id @default(uuid())
  practiceId                     String   @unique
  practice                       Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  clinicName                     String?
  address                        String?
  phone                          String?
  email                          String?
  registrationNumber             String?
  doctorName                     String?
  doctorRegistrationNumber       String?
  doctorQualifications           String?
  doctorPhone                    String?
  doctorEmail                    String?
  doctorAddress                  String?
  doctorPhotoUrl                 String?
  doctorSignatureUrl             String?
  clinicLogoUrl                  String?
  clinicLicenseNumber            String?
  ownerSpecialInstructionEnabled Boolean  @default(false)
  
  // Future-compatible membership field for MyKGVOA integration
  mykgvoaMemberId                String?

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// Future Clinical Models (Tenant-Scoped Placeholders for Stage 2+)
// Each model is strictly scoped by practiceId to guarantee tenant isolation.
// ------------------------------------------------------------------------------

model Owner {
  id         String    @id @default(uuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  alternatePhones String[]  @default([])
  email      String?
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  patients           Patient[]
  locations          OwnerLocation[]
  calls              Call[]
  visits             Visit[]
  followUps          FollowUp[]
  recurringSchedules RecurringSchedule[]

  @@index([practiceId])
  @@index([practiceId, phone])
}

model Patient {
  id                 String              @id @default(uuid())
  practiceId         String
  practice           Practice            @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  species            String
  breed              String?
  sex                String?
  ageYears           Int?
  ageMonths          Int?
  weightKg           Float?
  identification     String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  prescriptions      Prescription[]
  invoices           Invoice[]
  visitCases         VisitCase[]
  followUps          FollowUp[]
  recurringSchedules RecurringSchedule[]

  @@index([practiceId])
  @@index([ownerId])
}

model Medicine {
  id                           String    @id @default(uuid())
  practiceId                   String
  practice                     Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name                         String
  genericName                  String?
  category                     String?
  form                         String?
  strength                     String?
  unitPrice                    Float     @default(0)
  defaultDosageInstructions    String?
  reconstitutionDiluentVolume  Float?
  reconstitutionDiluentUnit    String?
  isActive                     Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  prescriptionItems            PrescriptionItem[]
  inventoryItems               InventoryItem[]

  @@index([practiceId])
  @@index([practiceId, name])
}

model TreatmentPackage {
  id          String   @id @default(uuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  totalPrice  Float    @default(0)
  itemsJson   Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([practiceId])
}

model Prescription {
  id              String             @id @default(uuid())
  practiceId      String
  practice        Practice           @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rxNumber        String
  diagnosis       String?
  notes                 String?
  status                String             @default("DRAFT") // "DRAFT", "PENDING_APPROVAL", "CHANGES_REQUESTED", "APPROVED", "CANCELLED", legacy: "Draft", "Final"
  version               Int                @default(1)
  prescribedAt          DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Workflow & Approval Fields
  forwardingRemarks     String?
  forwardedByUserId     String?
  forwardedByUser       User?              @relation("PrescriptionForwardedBy", fields: [forwardedByUserId], references: [id], onDelete: SetNull)
  forwardedToUserId     String?
  forwardedToUser       User?              @relation("PrescriptionForwardedTo", fields: [forwardedToUserId], references: [id], onDelete: SetNull)
  forwardedAt           DateTime?

  approvedByUserId      String?
  approvedByUser        User?              @relation("PrescriptionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  approvalRemarks       String?
  approvedVersion       Int?

  requestedByUserId     String?
  requestedByUser       User?              @relation("PrescriptionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedAt           DateTime?
  changeRequestRemarks  String?

  items                 PrescriptionItem[]
  invoiceItems          InvoiceItem[]
  workflowHistory       PrescriptionWorkflowHistory[]
  visitCases            VisitCase[]

  @@unique([practiceId, rxNumber])
  @@index([practiceId])
  @@index([patientId])
  @@index([status])
}

model PrescriptionWorkflowHistory {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  version        Int          @default(1)
  status         String
  action         String       // "CREATED", "FORWARDED", "CHANGES_REQUESTED", "APPROVED", "RESUBMITTED", "CANCELLED"
  actorUserId    String
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId   String?
  targetUser     User?        @relation("WorkflowHistoryTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  remarks        String?
  createdAt      DateTime     @default(now())

  @@index([prescriptionId])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName   String
  dosage         String
  frequency      String
  durationDays   Int          @default(1)
  totalQuantity  Float        @default(1)
  quantityUnit   String?
  instructions   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([prescriptionId])
  @@index([medicineId])
}

model Invoice {
  id            String        @id @default(uuid())
  practiceId    String
  practice      Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  invoiceNumber String
  subtotal      Float         @default(0)
  taxAmount     Float         @default(0)
  discountAmount Float        @default(0)
  totalAmount   Float         @default(0)
  status        String        @default("Issued") // "Draft", "Issued", "Paid", "Cancelled"
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  receipts      Receipt[]
  visitCases    VisitCase[]

  @@unique([practiceId, invoiceNumber])
  @@index([practiceId])
}

model InvoiceItem {
  id             String        @id @default(uuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  description    String
  category       String        @default("Medicine")
  unitPrice      Float         @default(0)
  quantity       Float         @default(1)
  totalPrice     Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId])
  @@index([prescriptionId])
}

model Receipt {
  id            String   @id @default(uuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNumber String
  amountPaid    Float
  paymentMode   String   @default("CASH") // "CASH", "UPI", "CARD"
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([practiceId, receiptNumber])
  @@index([practiceId])
  @@index([invoiceId])
}

model DocumentSequence {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  docType    String   // "PRESCRIPTION", "INVOICE", "RECEIPT"
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([practiceId, docType, year])
  @@index([practiceId])
}

model AuditLog {
  id         String    @id @default(uuid())
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String    // "LOGIN", "REGISTER", "LOGOUT", "PRACTICE_UPDATE"
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([practiceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// Commercial SaaS Domain Models (Phase 10 Foundation)
// Practice is the commercial tenant. Subscriptions and Payments belong to Practice.
// ------------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  THREE_MONTHS
  ANNUAL
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

model SubscriptionPlan {
  id              String          @id @default(uuid())
  code            String          @unique // e.g. "TRIAL", "MONTHLY", "THREE_MONTHS", "ANNUAL"
  name            String          // Human-readable plan name
  description     String?
  interval        BillingInterval @default(MONTHLY)
  intervalCount   Int             @default(1)
  pricePaisa      Int             // Stored in integer paise (INR), e.g. 59900 = ₹599.00
  currency        String          @default("INR")
  trialPeriodDays Int             @default(0)
  maxUserSeats    Int             @default(1)
  featuresJson    Json            @default("{}")
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions   Subscription[]

  @@index([code])
  @@index([isActive])
}

model Subscription {
  id                    String             @id @default(uuid())
  practiceId            String
  practice              Practice           @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  planId                String
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                SubscriptionStatus @default(TRIAL)
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  cancelledAt           DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  gracePeriodEndsAt     DateTime?
  gatewayCustomerId     String?            // Future PayU or provider customer reference
  gatewaySubscriptionId String?            // Future recurring subscription reference
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  payments              Payment[]

  @@index([practiceId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id                   String        @id @default(uuid())
  practiceId           String
  practice             Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  subscriptionId       String?
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountPaisa          Int           // Strict integer paise: ₹100.00 = 10000
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  paymentProvider      String        @default("PAYU")
  internalReference    String        @unique // Unique internal payment tracking ID
  gatewayTransactionId String?       // External PayU txnid or reference
  paymentMethod        String?       // UPI, CARD, NETBANKING
  gatewayResponseRaw   Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  events               PaymentEvent[]

  @@index([practiceId])
  @@index([subscriptionId])
  @@index([status])
  @@index([gatewayTransactionId])
}

model PaymentEvent {
  id               String    @id @default(uuid())
  paymentId        String?
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider         String    // e.g. "PAYU"
  eventId          String    // External event ID or gateway transaction ID
  eventType        String    // e.g. "PAYMENT_SUCCESS", "PAYMENT_FAILED"
  payloadHash      String?   // SHA-256 hash of raw payload
  rawPayload       Json?
  processingStatus String    @default("PROCESSED") // "RECEIVED", "PROCESSED", "FAILED", "IGNORED"
  errorMessage     String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@unique([provider, eventId]) // STRICT IDEMPOTENCY: Duplicate delivery rejected safely
  @@index([paymentId])
  @@index([receivedAt])
}

// ------------------------------------------------------------------------------
// Platform SaaS Administration Models (Phase 14 Extension)
// ------------------------------------------------------------------------------

model PlatformIssue {
  id               String        @id @default(uuid())
  practiceId       String?
  practice         Practice?     @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?         @relation("ReportedIssues", fields: [userId], references: [id], onDelete: SetNull)
  category         IssueCategory @default(OTHER)
  priority         IssuePriority @default(NORMAL)
  status           IssueStatus   @default(OPEN)
  title            String
  description      String
  assignedToUserId String?
  assignedTo       User?         @relation("AssignedIssues", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  internalNotes    Json?         @default("[]")
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([practiceId])
  @@index([userId])
  @@index([status])
  @@index([priority])
}

model SupportAccessSession {
  id                  String    @id @default(uuid())
  platformAdminUserId String
  platformAdmin       User      @relation("SupportAdminSessions", fields: [platformAdminUserId], references: [id], onDelete: Restrict)
  targetPracticeId    String
  targetPractice      Practice  @relation(fields: [targetPracticeId], references: [id], onDelete: Cascade)
  targetUserId        String?
  targetUser          User?     @relation("TargetSupportSessions", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason              String
  isReadOnly          Boolean   @default(true)
  status              String    @default("ACTIVE") // "ACTIVE", "ENDED", "EXPIRED"
  startedAt           DateTime  @default(now())
  expiresAt           DateTime
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([platformAdminUserId])
  @@index([targetPracticeId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Inventory & Stock Management Models (Add-On Module V1)
// Strictly scoped to Practice boundary.
// ------------------------------------------------------------------------------

enum InventoryCategory {
  MEDICINE
  CONSUMABLE
  LAB_MATERIAL
  SURGICAL_MATERIAL
  OTHER
}

enum InventoryTransactionType {
  OPENING_STOCK
  PURCHASE
  SALE_OR_INVOICE
  STOCK_ADJUSTMENT
  RETURN_TO_SUPPLIER
  EXPIRED
  DAMAGED
  WASTAGE
  REVERSAL
}

model StockLocation {
  id          String   @id @default(uuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     InventoryBatch[]

  @@unique([practiceId, name])
  @@index([practiceId])
}

model Supplier {
  id          String   @id @default(uuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  gstin       String?
  address     String?
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   PurchaseInvoice[]

  @@index([practiceId])
  @@index([practiceId, name])
}

model InventoryItem {
  id                 String            @id @default(uuid())
  practiceId         String
  practice           Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  category           InventoryCategory @default(MEDICINE)
  name               String
  genericName        String?
  strength           String?
  dosageForm         String?
  presentation       String?
  packSize           String?
  stockUnit          String            @default("Unit")
  manufacturer       String?
  minimumStockLevel  Int               @default(5)
  targetStockLevel   Int               @default(20)
  barcode            String?
  medicineId         String?
  medicine           Medicine?         @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  batches            InventoryBatch[]
  transactions       InventoryTransaction[]
  purchaseItems      PurchaseInvoiceItem[]

  @@index([practiceId])
  @@index([practiceId, category])
  @@index([practiceId, barcode])
  @@index([medicineId])
}

model InventoryBatch {
  id                 String        @id @default(uuid())
  practiceId         String
  practice           Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  batchNumber        String
  manufacturingDate  DateTime?
  expiryDate         DateTime
  currentQuantity    Float         @default(0)
  initialQuantity    Float         @default(0)
  purchaseRate       Float         @default(0)
  mrp                Float         @default(0)
  locationId         String?
  location           StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transactions       InventoryTransaction[]

  @@index([practiceId])
  @@index([inventoryItemId])
  @@index([expiryDate])
  @@index([practiceId, batchNumber])
}

model InventoryTransaction {
  id                 String                   @id @default(uuid())
  practiceId         String
  practice           Practice                 @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  itemId             String
  item               InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId            String?
  batch              InventoryBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  transactionType    InventoryTransactionType
  quantityChange     Float
  quantityBefore     Float
  quantityAfter      Float
  unitCost           Float                    @default(0)
  referenceType      String?
  referenceId        String?
  reason             String?
  performedByUserId  String?
  createdAt          DateTime                 @default(now())

  @@index([practiceId])
  @@index([itemId])
  @@index([batchId])
  @@index([transactionType])
  @@index([createdAt])
}

model PurchaseInvoice {
  id                 String                @id @default(uuid())
  practiceId         String
  practice           Practice              @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  supplierId         String?
  supplier           Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName       String
  supplierGstin      String?
  invoiceNumber      String
  invoiceDate        DateTime
  totalAmount        Float                 @default(0)
  notes              String?
  documentFileName   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  items              PurchaseInvoiceItem[]

  @@unique([practiceId, supplierName, invoiceNumber])
  @@index([practiceId])
  @@index([invoiceDate])
}

model PurchaseInvoiceItem {
  id                 String          @id @default(uuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  itemName           String
  category           InventoryCategory
  presentation       String?
  batchNumber        String
  manufacturingDate  DateTime?
  expiryDate         DateTime
  quantity           Float           @default(1)
  purchaseRate       Float           @default(0)
  mrp                Float           @default(0)
  lineTotal          Float           @default(0)

  @@index([purchaseInvoiceId])
  @@index([inventoryItemId])
}

// ------------------------------------------------------------------------------
// Call & Visit Planner (CVP) Domain Models
// Strictly scoped to Practice boundary.
// ------------------------------------------------------------------------------

enum CallPriority {
  EMERGENCY
  URGENT
  COULD_NOT_ASSESS
  PLANNED
}

enum VisitFlexibility {
  MUST_ATTEND_TODAY
  CAN_POSTPONE_TODAY
  PREFERRED_TODAY
  SPECIFIC_DATE
}

enum CallStatus {
  LOGGED
  SCHEDULED
  CANCELLED
}

enum VisitStatus {
  REGISTERED
  PLANNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
}

enum LocationSource {
  MANUAL
  GPS
  MAP
  SAVED
}

model Call {
  id                  String           @id @default(uuid())
  practiceId          String
  practice            Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  callerPhone         String
  ownerId             String?
  owner               Owner?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tempOwnerName       String?
  tempPatientName     String?
  species             String?
  animalCount         Int              @default(1)
  symptoms            String
  tentativeAssessment String?
  priority            CallPriority     @default(PLANNED)
  flexibility         VisitFlexibility @default(MUST_ATTEND_TODAY)
  preferredDate       DateTime?
  locationAddress     String?
  latitude            Float?
  longitude           Float?
  status              CallStatus       @default(LOGGED)
  plannedProcedure    String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  visits              Visit[]

  @@index([practiceId])
  @@index([callerPhone])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model OwnerLocation {
  id             String         @id @default(uuid())
  practiceId     String
  practice       Practice       @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label          String         @default("Farm")
  address        String
  latitude       Float?
  longitude      Float?
  locationSource LocationSource @default(MANUAL)
  accuracy       Float?
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  visits         Visit[]

  @@index([practiceId])
  @@index([ownerId])
}

model Visit {
  id                       String           @id @default(uuid())
  practiceId               String
  practice                 Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  callId                   String?
  call                     Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)
  ownerId                  String
  owner                    Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  locationId               String?
  location                 OwnerLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  address                  String
  latitude                 Float?
  longitude                Float?
  status                   VisitStatus      @default(REGISTERED)
  priority                 CallPriority     @default(PLANNED)
  flexibility              VisitFlexibility @default(MUST_ATTEND_TODAY)
  scheduledDate            DateTime
  sequenceOrder            Int              @default(0)
  estimatedDurationMinutes Int              @default(30)
  actualDurationMinutes    Int?
  callRegisteredAt         DateTime         @default(now())
  scheduledAt              DateTime?
  routeStartedAt           DateTime?
  arrivedAt                DateTime?
  arrivalLatitude          Float?
  arrivalLongitude         Float?
  arrivalAccuracy          Float?
  visitStartedAt           DateTime?
  visitCompletedAt         DateTime?
  completionNotes          String?
  postponedReason          String?
  notes                    String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  cases                    VisitCase[]
  routeStops               RouteStop[]
  procedures               VisitProcedure[]
  medicineUsages           VisitMedicineUsage[]
  timelineEvents           VisitTimelineEvent[]
  originFollowUps          FollowUp[]       @relation("VisitOriginFollowUps")
  scheduledFollowUps       FollowUp[]       @relation("FollowUpScheduledVisit")

  @@index([practiceId])
  @@index([ownerId])
  @@index([status])
  @@index([scheduledDate])
}

model VisitCase {
  id                 String        @id @default(uuid())
  practiceId         String
  visitId            String
  visit              Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId          String?
  patient            Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  chiefComplaint     String
  tentativeDiagnosis String?
  procedureCategory  String?
  notes              String?
  prescriptionId     String?
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  invoiceId          String?
  invoice            Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([practiceId])
  @@index([visitId])
  @@index([patientId])
}

model VisitProcedure {
  id                String    @id @default(uuid())
  practiceId        String
  visitId           String
  visit             Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId         String?
  patientName       String?
  procedureCategory String
  procedureName     String
  notes             String?
  standardFee       Float?    @default(0)
  performedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([practiceId])
  @@index([visitId])
  @@index([patientId])
}

model VisitMedicineUsage {
  id               String    @id @default(uuid())
  practiceId       String
  visitId          String
  visit            Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId        String?
  patientName      String?
  medicineId       String?
  medicineName     String
  batchNumber      String?
  quantityUsed     Float
  unit             String?
  route            String?
  instructions     String?
  isStockDeducted  Boolean   @default(false)
  stockDeductionId String?
  administeredAt   DateTime  @default(now())
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())

  @@index([practiceId])
  @@index([visitId])
  @@index([patientId])
}

model VisitTimelineEvent {
  id          String   @id @default(uuid())
  practiceId  String
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([practiceId])
  @@index([visitId])
  @@index([eventType])
}

model DailyPlan {
  id                          String      @id @default(uuid())
  practiceId                  String
  practice                    Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  planDate                    DateTime
  doctorUserId                String?
  startLocationAddress        String?
  startLatitude               Float?
  startLongitude              Float?
  endLocationAddress          String?
  totalEstimatedKm            Float       @default(0)
  totalEstimatedTravelMinutes Int         @default(0)
  totalEstimatedVisitMinutes  Int         @default(0)
  workingMinutesAvailable     Int         @default(480)
  isLocked                    Boolean     @default(false)
  status                      String      @default("DRAFT")
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  routeStops                  RouteStop[]

  @@unique([practiceId, planDate])
  @@index([practiceId])
  @@index([planDate])
}

model RouteStop {
  id                 String    @id @default(uuid())
  dailyPlanId        String
  dailyPlan          DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  visitId            String
  visit              Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  stopOrder          Int       @default(0)
  estimatedArrival   DateTime?
  estimatedDeparture DateTime?
  isLocked           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([dailyPlanId])
  @@index([visitId])
}

// ------------------------------------------------------------------------------
// Phase 8: Follow-ups, Recurring Visits & Procedure Duration Estimates
// ------------------------------------------------------------------------------

enum FollowUpReason {
  POST_TREATMENT_REVIEW
  RECHECK
  VACCINATION
  DEWORMING
  PREGNANCY_DIAGNOSIS
  ARTIFICIAL_INSEMINATION
  POST_OPERATIVE_REVIEW
  OTHER
}

enum FollowUpStatus {
  UPCOMING
  DUE
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
  OVERDUE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM_INTERVAL
}

enum DurationEstimateSource {
  DEFAULT
  PRACTICE_LEARNED
  MANUAL_OVERRIDE
}

model FollowUp {
  id                   String           @id @default(uuid())
  practiceId           String
  practice             Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  patientId            String?
  patient              Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  species              String?
  animalCount          Int              @default(1)
  originVisitId        String?
  originVisit          Visit?           @relation("VisitOriginFollowUps", fields: [originVisitId], references: [id], onDelete: SetNull)
  recurrenceRuleId     String?
  recurrenceSchedule   RecurringSchedule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  reason               FollowUpReason   @default(POST_TREATMENT_REVIEW)
  procedureCategory    String?
  recommendedDate      DateTime
  priority             CallPriority     @default(PLANNED)
  flexibility          VisitFlexibility @default(MUST_ATTEND_TODAY)
  preferredTimeWindow  String?
  notes                String?
  status               FollowUpStatus   @default(UPCOMING)
  scheduledVisitId     String?
  scheduledVisit       Visit?           @relation("FollowUpScheduledVisit", fields: [scheduledVisitId], references: [id], onDelete: SetNull)
  scheduledCallId      String?
  reminderSentAt       DateTime?
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([practiceId])
  @@index([ownerId])
  @@index([patientId])
  @@index([status])
  @@index([recommendedDate])
  @@index([recurrenceRuleId])
}

model RecurringSchedule {
  id                         String              @id @default(uuid())
  practiceId                 String
  practice                   Practice            @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  ownerId                    String
  owner                      Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  patientId                  String?
  patient                    Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  species                    String?
  reason                     FollowUpReason      @default(POST_TREATMENT_REVIEW)
  procedureCategory          String?
  frequency                  RecurrenceFrequency @default(WEEKLY)
  intervalDays               Int?
  startDate                  DateTime
  endDate                    DateTime?
  maxOccurrences             Int?
  generatedOccurrencesCount  Int                 @default(0)
  priority                   CallPriority        @default(PLANNED)
  flexibility                VisitFlexibility    @default(MUST_ATTEND_TODAY)
  preferredTimeWindow        String?
  notes                      String?
  status                     String              @default("ACTIVE")
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  followUps                  FollowUp[]

  @@index([practiceId])
  @@index([ownerId])
  @@index([status])
}

model ProcedureDurationEstimate {
  id                          String                 @id @default(uuid())
  practiceId                  String
  practice                    Practice               @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  procedureCategory           String
  defaultDurationMinutes      Int                    @default(30)
  learnedDurationMinutes      Int?
  manualOverrideMinutes       Int?
  sampleCount                 Int                    @default(0)
  source                      DurationEstimateSource @default(DEFAULT)
  effectiveDurationMinutes    Int                    @default(30)
  incrementalPerAnimalMinutes Int                    @default(10)
  lastCalculatedAt            DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@unique([practiceId, procedureCategory])
  @@index([practiceId])
}


