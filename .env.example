# ==============================================================================
# VetRx Environment Configuration Template (.env.example)
#
# DO NOT store production secrets in this template or commit real credentials.
# Copy this file to .env and configure values appropriately for your environment.
# ==============================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Server Configuration
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://vetrx:vetrx_dev_password@localhost:5432/vetrx?schema=public

# Database Credentials (for docker-compose services)
POSTGRES_DB=vetrx
POSTGRES_USER=vetrx
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432

# Session Security (Server-side HTTP-Only Cookies)
# Must be at least 32 characters long in production
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters_here
SESSION_TTL_DAYS=30
COOKIE_NAME=vetrx_session

# CORS Configuration (Allowed origins, comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20
